# =============================================================================
# PostgreSQL 数据库配置
# =============================================================================
# 格式: postgresql://username:password@host:port/database_name?schema=public
#
# 基础连接配置说明:
#   - POSTGRES_HOST: 数据库服务器地址 (本地宿主机用 localhost，Docker 容器环境用 postgres)
#   - POSTGRES_PORT: 数据库端口 (默认: 5432)
#   - POSTGRES_DB: 数据库名称 (默认: lulab)
#   - POSTGRES_USER: 数据库用户名 (默认: postgres)
#   - POSTGRES_PASSWORD: 数据库密码 (生产环境必须设置强密码)
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="lulab"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_postgres_password"

# 数据库连接字符串 (Prisma 及应用程序使用)
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}"


# =============================================================================
# Redis 缓存与队列配置
# =============================================================================
# 用于系统缓存、分布式锁以及 BullMQ 任务队列
#
# 基础连接配置说明:
#   - REDIS_HOST: Redis 服务器地址 (本地宿主机用 localhost，Docker 容器环境用 redis)
#   - REDIS_PORT: Redis 服务器端口 (默认: 6379)
#   - REDIS_PASSWORD: Redis 认证密码 (生产环境建议设置强密码)
#   - REDIS_DB: Redis 数据库编号 (默认: 0)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD="your_redis_password"
REDIS_DB=0

# Redis 连接字符串 (供应用程序连接池使用)
REDIS_URL="redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}"

# 本地 Docker Compose 运行选项 (可选，与 docker-compose.yml 保持一致)
REDIS_DATABASES=16
REDIS_MAXMEMORY="512mb"
REDIS_APPENDONLY="yes"


# =============================================================================
# Bull Board 队列监控面板配置
# =============================================================================
# 用于队列可视化监控面板 (/admin/queues) 的 HTTP Basic Auth 访问认证
# 安全提示: 生产环境请务必设置高强度账号密码，严禁使用默认值
BULL_BOARD_USER="admin"
BULL_BOARD_PASSWORD="your_bull_board_password"


# =============================================================================
# 服务器基础配置
# =============================================================================
# 配置说明:
#   - PORT: API 服务监听端口 (默认: 3000)
#   - NODE_ENV: 运行环境 (development 开发环境, production 生产环境, test 测试环境)
#   - NOVE_ADMIN_URL: Nove Admin 前端地址 (用于 OAuth 授权重定向、CORS 放行等)
#   - WORKER_ID: 集群部署订单号 Worker 标识 (两位数字如 01-99，默认: 01)
PORT=3000
NODE_ENV="development"
NOVE_ADMIN_URL="http://localhost:5173"
WORKER_ID="01"


# =============================================================================
# 跨域安全配置 (CORS)
# =============================================================================
# CORS_ORIGINS: 精确允许的前端域名 (多个域名使用英文逗号分隔)
#   - 本地开发: http://localhost:5173,http://localhost:3000
#   - 生产环境: https://admin.yourdomain.com,https://api.yourdomain.com
CORS_ORIGINS="http://localhost:5173"

# CORS_ORIGIN_REGEXES: 允许匹配的动态域名正则 (多个使用英文逗号分隔，适用于 Vercel / Netlify / Cloudflare Pages 预览环境)
CORS_ORIGIN_REGEXES="^https:\/\/.*\.vercel\.app$,^https:\/\/.*\.netlify\.app$,^https:\/\/.*\.pages\.dev$"

# CORS_CREDENTIALS: 是否允许携带认证凭据 (Cookie、Authorization 请求头等，使用 Cookie 需设为 true)
CORS_CREDENTIALS=true


# =============================================================================
# 安全与加密密钥配置 (Security & Encryption Keys)
# =============================================================================
# 包含 JWT 认证、开放平台 API Key 签名、以及系统敏感数据对称加密密钥。
#
# 🔐 密钥生成建议 (所有密钥均要求至少 32 字符的强随机串，且每个配置项必须使用独立的强随机密钥):
#   openssl rand -hex 32
#   或 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# ⚠️  核心安全原则:
#   1. 生产环境必须使用强随机密钥，绝对不能使用默认占位值，严禁多个配置项共用同一密钥！
#   2. JWT 与 API Key 属于接口鉴权密钥，若泄漏可通过重新签发/密钥轮换恢复；
#   3. SYSTEM_ENCRYPTION_KEY 负责数据库中已落库敏感数据的 AES-256-GCM 双向解密，严禁擅自改动！
#      若在未完成历史数据重加密迁移前随意更换，所有已加密的历史数据将永久无法还原！

# -----------------------------------------------------------------------------
# 1. JWT 用户身份认证配置
# -----------------------------------------------------------------------------
# 用于用户端及管理端登录认证与会话管理
#   - JWT_SECRET: 访问令牌密钥 (Access Token)
#   - JWT_REFRESH_SECRET: 刷新令牌密钥 (Refresh Token，必须不同于 JWT_SECRET)
#   - JWT_EXPIRES_IN: 访问令牌有效期 (推荐 15m)
#   - JWT_REFRESH_EXPIRES_IN: 刷新令牌有效期 (推荐 7d)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-this-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# -----------------------------------------------------------------------------
# 2. 开放平台 API Key 管理配置
# -----------------------------------------------------------------------------
# 用于外部开发者或系统调用开放 API 时的 HMAC-SHA256 签名与鉴权验证
#   - API_KEY_SECRET: API Key 签名密钥 (必须使用至少 32 字符的独立随机密钥，不同于 JWT_SECRET)
API_KEY_SECRET="your-super-secret-api-key-secret-change-this-in-production"

# -----------------------------------------------------------------------------
# 3. 系统敏感数据主加密配置 (AES-256-GCM)
# -----------------------------------------------------------------------------
# 用于服务集成敏感凭证入库、敏感身份信息及联系方式换绑审计的双向对称加密。
#
# 💡 提示：第三方服务集成凭证（对象存储/OSS、阿里云短信、腾讯会议、微信小店、飞书应用、企业微信、SMTP邮件、AI模型、文件扫描等）
# 集成注册表中的参数在 Nove Admin 管理后台「服务集成」中管理，敏感字段加密存储。
# 例外：阿里云文件扫描的访问凭证仍由服务端阿里云凭证链提供，见下方配置。
# 详细字段配置与开通指南请查阅文档: docs/developer/integrations/service-integrations.md
#
# 系统主加密密钥 (至少 32 字节，严禁线上随意变更)
SYSTEM_ENCRYPTION_KEY="your-32-byte-long-secure-random-key"
# 联系方式安全审计的密钥版本标识（默认 v1）；仅用于记录版本，不提供自动多密钥解密或轮换
SYSTEM_ENCRYPTION_KEY_VERSION="v1"


# =============================================================================
# 阿里云文件扫描访问凭证（仅使用 ALIYUN_SAS 时需要）
# =============================================================================
# 扫描参数在「服务集成 → 文件扫描」中维护，访问凭证仍由 @alicloud/credentials 获取。
# 可使用部署环境的 RAM 角色；若选择环境变量凭证，按需填写以下项目。
# 对象存储与短信使用各自的后台集成凭据，不从这里读取。
# ALIBABA_CLOUD_ACCESS_KEY_ID="your-access-key-id"
# ALIBABA_CLOUD_ACCESS_KEY_SECRET="your-access-key-secret"
