model OrderSyncJob {
  id String @id @default(cuid())

  mode     OrderSyncMode
  timeType OrderSyncTimeType @map("time_type")
  status   OrderSyncStatus   @default(PENDING)

  startTime DateTime @map("start_time") @db.Timestamptz(6)
  endTime   DateTime @map("end_time") @db.Timestamptz(6)

  currentStart DateTime? @map("current_start") @db.Timestamptz(6)
  currentEnd   DateTime? @map("current_end") @db.Timestamptz(6)
  nextKey      String?   @map("next_key")

  pageSize Int     @default(100) @map("page_size")
  wxStatus Int?    @map("wx_status")
  dryRun   Boolean @default(false) @map("dry_run")

  fetched     Int     @default(0)
  created     Int     @default(0)
  updated     Int     @default(0)
  failedCount Int     @default(0) @map("failed_count")
  failed      Json?   @db.JsonB
  lastError   String? @map("last_error")

  bullJobId   String?   @map("bull_job_id")
  startedAt   DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([mode, status], map: "idx_order_sync_jobs_mode_status")
  @@index([status, createdAt], map: "idx_order_sync_jobs_status_created_at")
  @@index([timeType, startTime, endTime], map: "idx_order_sync_jobs_time_range")
  @@map("order_sync_jobs")
}

enum OrderSyncMode {
  HISTORY
  INCREMENTAL
}

enum OrderSyncTimeType {
  CREATE
  UPDATE
}

enum OrderSyncStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  PAUSED
}
