model RecordingParticipantSummary {
  id String @id @default(cuid())

  meetingId String  @map("meeting_id")
  meeting   Meeting @relation("MeetingRecordingParticipantSummaries", fields: [meetingId], references: [id], onDelete: Cascade)

  meetingRecordingId String           @map("meeting_recording_id")
  meetingRecording   MeetingRecording @relation("RecordingParticipantSummaries", fields: [meetingRecordingId], references: [id], onDelete: Cascade)

  platformUserId String       @map("platform_user_id")
  platformUser   PlatformUser @relation("RecordingParticipantSummaries", fields: [platformUserId], references: [id], onDelete: Restrict)

  meetingParticipantId String?             @map("meeting_participant_id")
  meetingParticipant   MeetingParticipant? @relation("RecordingParticipantSummaries", fields: [meetingParticipantId], references: [id], onDelete: SetNull)

  userName    String            @map("user_name") @db.VarChar(100)
  partSummary String            @map("part_summary") @db.Text
  keywords    String[]
  generatedBy GenerationMethod? @map("generated_by")
  aiModel     String?           @map("ai_model")
  confidence  Float?

  versionGroupKey   String                        @map("version_group_key") @db.VarChar(500)
  version           Int                           @default(1)
  isLatest          Boolean                       @default(true) @map("is_latest")
  previousSummaryId String?                       @map("previous_summary_id")
  previousSummary   RecordingParticipantSummary?  @relation("RecordingParticipantSummaryVersions", fields: [previousSummaryId], references: [id], onDelete: SetNull)
  nextVersions      RecordingParticipantSummary[] @relation("RecordingParticipantSummaryVersions")

  reportSources   TrackingReportRecordingSummarySource[]
  observedStartAt DateTime?                              @map("observed_start_at") @db.Timestamptz(6)
  observedEndAt   DateTime?                              @map("observed_end_at") @db.Timestamptz(6)
  createdAt       DateTime                               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                               @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?                              @map("deleted_at") @db.Timestamptz(6)

  @@unique([versionGroupKey, version], map: "uq_recording_participant_summary_version")
  @@index([meetingId, meetingRecordingId, deletedAt])
  @@index([meetingRecordingId, platformUserId, deletedAt])
  @@index([meetingParticipantId])
  @@index([previousSummaryId])
  @@map("recording_participant_summaries")
}

enum TrackingReportType {
  PERIODIC_MEETING_SUMMARY
  TRAINING_PLAN
  PROJECT_PROGRESS
  USER_PROFILE
}

enum TrackingCadence {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}

model UserTrackingReport {
  id             String        @id @default(cuid())
  subjectUserId  String?       @map("subject_user_id")
  subjectUser    User?         @relation("UserTrackingReports", fields: [subjectUserId], references: [id], onDelete: SetNull)
  platformUserId String?       @map("platform_user_id")
  platformUser   PlatformUser? @relation("UserTrackingReports", fields: [platformUserId], references: [id], onDelete: SetNull)
  projectId      String?       @map("project_id")
  project        Project?      @relation("ProjectTrackingReports", fields: [projectId], references: [id], onDelete: Restrict)

  subjectNameSnapshot String             @map("subject_name_snapshot") @db.VarChar(100)
  trackingType        TrackingReportType @map("tracking_type")
  cadence             TrackingCadence
  periodStart         DateTime           @map("period_start") @db.Timestamptz(6)
  periodEnd           DateTime           @map("period_end") @db.Timestamptz(6)
  timezone            String             @default("Asia/Shanghai") @db.VarChar(100)
  content             String             @db.Text
  structuredData      Json               @default("{}") @map("structured_data") @db.JsonB
  schemaVersion       Int                @default(1) @map("schema_version")
  generatedBy         GenerationMethod?  @map("generated_by")
  aiModel             String?            @map("ai_model")
  confidence          Float?

  versionGroupKey         String                                 @map("version_group_key") @db.VarChar(700)
  version                 Int                                    @default(1)
  isLatest                Boolean                                @default(true) @map("is_latest")
  previousReportId        String?                                @map("previous_report_id")
  previousReport          UserTrackingReport?                    @relation("UserTrackingReportVersions", fields: [previousReportId], references: [id], onDelete: SetNull)
  nextVersions            UserTrackingReport[]                   @relation("UserTrackingReportVersions")
  recordingSummarySources TrackingReportRecordingSummarySource[]
  sourceReports           TrackingReportSourceReport[]           @relation("DerivedTrackingReport")
  derivedReports          TrackingReportSourceReport[]           @relation("SourceTrackingReport")
  createdAt               DateTime                               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                               @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt               DateTime?                              @map("deleted_at") @db.Timestamptz(6)

  @@unique([versionGroupKey, version], map: "uq_user_tracking_report_version")
  @@index([subjectUserId, trackingType, periodStart])
  @@index([platformUserId, trackingType, periodStart])
  @@index([projectId, trackingType, periodStart])
  @@index([trackingType, cadence, periodStart])
  @@index([previousReportId])
  @@map("user_tracking_reports")
}

model TrackingReportRecordingSummarySource {
  id                 String                      @id @default(cuid())
  reportId           String                      @map("report_id")
  report             UserTrackingReport          @relation(fields: [reportId], references: [id], onDelete: Cascade)
  recordingSummaryId String                      @map("recording_summary_id")
  recordingSummary   RecordingParticipantSummary @relation(fields: [recordingSummaryId], references: [id], onDelete: Cascade)
  metadata           Json                        @default("{}") @db.JsonB
  createdAt          DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([reportId, recordingSummaryId])
  @@index([recordingSummaryId])
  @@map("tracking_report_recording_summary_sources")
}

model TrackingReportSourceReport {
  id             String             @id @default(cuid())
  reportId       String             @map("report_id")
  report         UserTrackingReport @relation("DerivedTrackingReport", fields: [reportId], references: [id], onDelete: Cascade)
  sourceReportId String             @map("source_report_id")
  sourceReport   UserTrackingReport @relation("SourceTrackingReport", fields: [sourceReportId], references: [id], onDelete: Cascade)
  metadata       Json               @default("{}") @db.JsonB
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([reportId, sourceReportId])
  @@index([sourceReportId])
  @@map("tracking_report_source_reports")
}
