model ScheduledTask {
  id        String     @id @default(cuid())
  name      String
  handler   String     @default("invoke_http")
  type      TaskType
  queueName String     @map("queue_name")
  jobId     String?    @map("job_id") // BullMQ job id (once 任务可能有，cron 的每次实例化也会生成临时 id)
  repeatKey String?    @map("repeat_key") // BullMQ repeatable job 的唯一键 (removeRepeatable 用)
  cron      String? // CRON 表达式（type=CRON 时必填）
  timezone  String? // 时区（type=CRON 时使用，例如 "Asia/Shanghai"）
  runAt     DateTime?  @map("run_at") @db.Timestamptz(6) // 一次性任务的执行时间（精确到毫秒）
  payload   Json // 任意业务数据
  status    TaskStatus @default(PENDING)
  lastError String?    @map("last_error")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?  @map("deleted_at") @db.Timestamptz(6)

  executionLogs TaskExecutionLog[]

  @@index([queueName])
  @@index([type])
  @@index([status])
  @@map("scheduled_tasks")
}

model TaskExecutionLog {
  id              String     @id @default(cuid())
  scheduledTaskId String     @map("scheduled_task_id")
  jobId           String     @map("job_id") // BullMQ 中实际执行的 Job ID
  status          TaskStatus
  error           String?    @db.Text
  result          Json?
  startedAt       DateTime   @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt     DateTime?  @map("completed_at") @db.Timestamptz(6)

  scheduledTask ScheduledTask @relation(fields: [scheduledTaskId], references: [id], onDelete: Cascade)

  @@index([scheduledTaskId])
  @@index([jobId])
  @@map("task_execution_logs")
}

enum TaskType {
  ONCE
  CRON
}

enum TaskStatus {
  PENDING
  SCHEDULED
  RUNNING
  COMPLETED
  FAILED
  PAUSED
}
