model ScheduledTask {
  id        String     @id @default(cuid())
  name      String
  type      TaskType
  queueName String
  jobId     String? // BullMQ job id (once 任务可能有，cron 的每次实例化也会生成临时 id)
  repeatKey String? // BullMQ repeatable job 的唯一键 (removeRepeatable 用)
  cron      String? // CRON 表达式（type=CRON 时必填）
  timezone  String? // 时区（type=CRON 时使用，例如 "Asia/Shanghai"）
  runAt     DateTime? // 一次性任务的执行时间（精确到毫秒）
  payload   Json // 任意业务数据
  status    TaskStatus @default(PENDING)
  lastError String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  executionLogs TaskExecutionLog[]

  @@index([queueName])
  @@index([type])
  @@index([status])
  @@map("scheduled_tasks")
}

model TaskExecutionLog {
  id              String        @id @default(cuid())
  scheduledTaskId String
  jobId           String        // BullMQ 中实际执行的 Job ID
  status          TaskStatus
  error           String?       // 执行失败时的错误信息
  result          Json?         // 执行成功时的返回结果
  startedAt       DateTime      @default(now())
  completedAt     DateTime?

  scheduledTask   ScheduledTask @relation(fields: [scheduledTaskId], references: [id], onDelete: Cascade)

  @@index([scheduledTaskId])
  @@index([jobId])
  @@map("task_execution_logs")
}

enum TaskType {
  ONCE
  CRON
}

enum TaskStatus {
  PENDING
  SCHEDULED
  RUNNING
  COMPLETED
  FAILED
  PAUSED
}
